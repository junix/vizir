  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "document_id": {
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/SceneOp"
      },
      "type": "array"
    },
    "protocol_version": {
      "default": "0.1",
      "type": "string"
    },
    "target_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "transaction_id": {
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "transaction_id",
    "base_revision",
    "target_revision",
    "operations"
  ],
  "title": "ScenePatch",
  "type": "object"
}