        "source",
        "target",
        "fidelity",
        "reason"
      ],
      "type": "object"
    },
    "LoweringFidelity": {
      "enum": [
        "lossless",
        "semantically-equivalent",
        "visually-approximate",
        "rasterized",
        "dropped"
      ],
      "type": "string"
    },
    "Origin": {
