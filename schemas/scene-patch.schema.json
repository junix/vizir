      "enum": [
        "start",
        "middle",
        "end"
      ],
      "type": "string"
    },
    "Transform2D": {
      "additionalProperties": false,
      "properties": {
        "rotate_degrees": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "scale": {
          "$ref": "#/$defs/Point",
          "default": {
            "x": 1.0,
            "y": 1.0
          }
        },
        "translate": {
          "$ref": "#/$defs/Point",
          "default": {
            "x": 0.0,
            "y": 0.0
          }
        }
      },
      "type": "object"
    }
