{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "vizir.render-receipt/v3"
    },
    "profile": {
      "const": "vizir-compiled-svg/3"
    },
    "provider": {
      "type": "object",
      "properties": {
        "id": {
          "const": "plot-provider-vizir"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "document_id": {
      "type": "string"
    },
    "source_ir_version": {
      "const": "0.7"
    },
    "source_context_format": {
      "const": "vizir-compiled-mir/1"
    },
    "compilation_context": {
      "type": "object",
      "properties": {
        "theme": {
          "$ref": "#/$defs/ThemeContext"
        },
        "text": {
          "$ref": "#/$defs/TextContext"
        },
        "text_layout": {
          "$ref": "#/$defs/TextLayoutContext"
        }
      },
      "required": [
        "theme",
        "text"
      ],
      "additionalProperties": false
    },
    "background": {
      "type": "string"
    },
    "capability_report": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "backend_version": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "accepted_ir": {
          "type": "string"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "feature": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "exact",
                  "equivalent",
                  "approximate",
                  "rasterized",
                  "dropped",
                  "error"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "feature",
              "status",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "backend",
        "backend_version",
        "document_id",
        "accepted_ir",
        "decisions"
      ],
      "additionalProperties": false
    },
    "losses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LossRecord"
      }
    },
    "artifact_receipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "plot.artifact-receipt-core/v1"
        },
        "inputs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "input",
                  "text_profile",
                  "text_layout",
                  "font_1",
                  "font_2",
                  "font_3"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 33554432
              }
            },
            "required": [
              "role",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          }
        },
        "primary": {
          "type": "object",
          "properties": {
            "artifact_id": {
              "const": "figure"
            },
            "role": {
              "const": "primary"
            },
            "argument": {
              "const": "output"
            },
            "kind": {
              "const": "svg"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 33554432
            }
          },
          "required": [
            "artifact_id",
            "role",
            "argument",
            "kind",
            "sha256",
            "bytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "inputs",
        "primary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "profile",
    "provider",
    "document_id",
    "source_ir_version",
    "source_context_format",
    "compilation_context",
    "background",
    "capability_report",
    "losses",
    "artifact_receipt"
  ],
  "additionalProperties": false,
  "$defs": {
    "LossRecord": {
      "additionalProperties": false,
      "properties": {
        "fidelity": {
          "$ref": "#/$defs/LoweringFidelity"
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "fidelity",
        "reason"
      ],
      "type": "object"
    },
    "LoweringFidelity": {
      "enum": [
        "lossless",
        "semantically-equivalent",
        "visually-approximate",
        "rasterized",
        "dropped"
      ],
      "type": "string"
    },
    "TextLayoutContext": {
      "oneOf": [
        {
          "$ref": "#/$defs/GeometryTextLayoutContext"
        },
        {
          "$ref": "#/$defs/SemanticTextLayoutContext"
        },
        {
          "$ref": "#/$defs/CategoryTextLayoutContext"
        },
        {
          "$ref": "#/$defs/DiagramTextLayoutContext"
        },
        {
          "$ref": "#/$defs/HeatmapTextLayoutContext"
        }
      ]
    },
    "DiagramTextLayoutContext": {
      "additionalProperties": false,
      "properties": {
        "diagram_targets": {
          "items": {
            "$ref": "#/$defs/DiagramTextLayoutTarget"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "engine": {
          "const": "unicode-linebreak/0.1.5(unicode15.0.0);unicode-segmentation/1.13.3(unicode17.0.0)",
          "type": "string"
        },
        "profile": {
          "const": "vizir-text-wrap/4",
          "type": "string"
        },
        "semantic_targets": {
          "items": {
            "$ref": "#/$defs/CategorySemanticTextLayoutTarget"
          },
          "maxItems": 256,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/TextLayoutTarget"
          },
          "maxItems": 256,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "profile",
        "engine",
        "targets",
        "diagram_targets"
      ],
      "type": "object"
    },
    "TextLayoutTarget": {
      "additionalProperties": false,
      "properties": {
        "line_height": {
          "format": "double",
          "maximum": 1000000,
          "minimum": 0.25,
          "type": "number"
        },
        "max_lines": {
          "format": "uint32",
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "max_width": {
          "format": "double",
          "maximum": 1000000,
          "minimum": 0.25,
          "type": "number"
        },
        "node_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "view_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "view_id",
        "node_id",
        "max_width",
        "max_lines",
        "line_height"
      ],
      "type": "object"
    },
    "CategorySemanticTextLayoutTarget": {
      "additionalProperties": false,
      "properties": {
        "line_height": {
          "format": "double",
          "maximum": 1000000,
          "minimum": 0.25,
          "type": "number"
        },
        "max_lines": {
          "format": "uint32",
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "max_width": {
          "format": "double",
          "maximum": 1000000,
          "minimum": 0.25,
          "type": "number"
        },
        "role": {
          "$ref": "#/$defs/CategoryTextLayoutRole"
        },
        "view_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "view_id",
        "role",
        "max_width",
        "max_lines",
        "line_height"
      ],
      "type": "object"
    },
    "CategoryTextLayoutRole": {
      "description": "A supported semantic text slot, resolved against original source fields.",
      "enum": [
        "chart.title",
        "bar.category_labels"
      ],
      "type": "string"
    },
    "DiagramTextLayoutTarget": {
      "additionalProperties": false,
      "description": "A diagram node label, selected by exact source view and node identities.",
      "properties": {
        "line_height": {
          "format": "double",
          "maximum": 1000000,
          "minimum": 0.25,
          "type": "number"
        },
        "max_lines": {
          "format": "uint32",
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "max_width": {
          "format": "double",
          "maximum": 1000000,
          "minimum": 0.25,
          "type": "number"
        },
        "node_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "view_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "view_id",
        "node_id",
        "max_width",
        "max_lines",
        "line_height"
      ],
      "type": "object"
    },
    "CategoryTextLayoutContext": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "unicode-linebreak/0.1.5(unicode15.0.0);unicode-segmentation/1.13.3(unicode17.0.0)",
          "type": "string"
        },
        "profile": {
          "const": "vizir-text-wrap/3",
          "type": "string"
        },
        "semantic_targets": {
          "contains": {
            "additionalProperties": true,
            "properties": {
              "role": {
                "const": "bar.category_labels"
              }
            },
            "required": [
              "role"
            ],
            "type": "object"
          },
          "items": {
            "$ref": "#/$defs/CategorySemanticTextLayoutTarget"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/TextLayoutTarget"
          },
          "maxItems": 256,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "profile",
        "engine",
        "targets",
        "semantic_targets"
      ],
      "type": "object"
    },
    "SemanticTextLayoutContext": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "unicode-linebreak/0.1.5(unicode15.0.0);unicode-segmentation/1.13.3(unicode17.0.0)",
          "type": "string"
        },
        "profile": {
          "const": "vizir-text-wrap/2",
          "type": "string"
        },
        "semantic_targets": {
          "items": {
            "$ref": "#/$defs/SemanticTextLayoutTarget"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/TextLayoutTarget"
          },
          "maxItems": 256,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "profile",
        "engine",
        "targets",
        "semantic_targets"
      ],
      "type": "object"
    },
    "SemanticTextLayoutTarget": {
      "additionalProperties": false,
      "properties": {
        "line_height": {
          "format": "double",
          "maximum": 1000000,
          "minimum": 0.25,
          "type": "number"
        },
        "max_lines": {
          "format": "uint32",
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "max_width": {
          "format": "double",
          "maximum": 1000000,
          "minimum": 0.25,
          "type": "number"
        },
        "role": {
          "$ref": "#/$defs/TextLayoutRole"
        },
        "view_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "view_id",
        "role",
        "max_width",
        "max_lines",
        "line_height"
      ],
      "type": "object"
    },
    "TextLayoutRole": {
      "description": "A supported semantic text slot, resolved against original source fields.",
      "enum": [
        "chart.title"
      ],
      "type": "string"
    },
    "GeometryTextLayoutContext": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "unicode-linebreak/0.1.5(unicode15.0.0);unicode-segmentation/1.13.3(unicode17.0.0)",
          "type": "string"
        },
        "profile": {
          "const": "vizir-text-wrap/1",
          "type": "string"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/TextLayoutTarget"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "profile",
        "engine",
        "targets"
      ],
      "type": "object"
    },
    "TextContext": {
      "additionalProperties": false,
      "properties": {
        "declared_locale": {
          "maxLength": 32,
          "minLength": 2,
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$",
          "type": "string"
        },
        "engine": {
          "const": "cosmic-text/0.19.0;harfrust/0.5.2;skrifa/0.40.0",
          "type": "string"
        },
        "faces": {
          "$ref": "#/$defs/TextFaces"
        },
        "profile": {
          "const": "vizir-text-outlines/1",
          "type": "string"
        },
        "shaping_language": {
          "const": "default",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "engine",
        "declared_locale",
        "shaping_language",
        "faces"
      ],
      "type": "object"
    },
    "TextFaces": {
      "additionalProperties": false,
      "properties": {
        "bold": {
          "$ref": "#/$defs/FontFace",
          "properties": {
            "weight": {
              "const": 700
            }
          }
        },
        "medium": {
          "$ref": "#/$defs/FontFace",
          "properties": {
            "weight": {
              "const": 500
            }
          }
        },
        "regular": {
          "$ref": "#/$defs/FontFace",
          "properties": {
            "weight": {
              "const": 400
            }
          }
        }
      },
      "required": [
        "regular",
        "medium",
        "bold"
      ],
      "type": "object"
    },
    "FontFace": {
      "additionalProperties": false,
      "properties": {
        "face_index": {
          "format": "uint32",
          "maximum": 31,
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "weight": {
          "enum": [
            400,
            500,
            700
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "face_index",
        "weight"
      ],
      "type": "object"
    },
