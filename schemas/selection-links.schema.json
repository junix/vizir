{
  "$defs": {
    "SelectionGroup": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$(?![\\s\\S])",
          "type": "string"
        },
        "members": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "members"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "type": "string"
    },
    "format": {
      "const": "vizir-selection-links/1",
      "type": "string"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/SelectionGroup"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    },
    "instance_key": {
      "pattern": "^[a-z][a-z0-9-]{0,31}$(?![\\s\\S])",
      "type": "string"
    },
    "scene_sha256": {
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
      "type": "string"
    }
  },
  "required": [
    "format",
    "document_id",
    "scene_sha256",
    "instance_key",
    "groups"
  ],
  "title": "SelectionLinks",
  "type": "object"
}